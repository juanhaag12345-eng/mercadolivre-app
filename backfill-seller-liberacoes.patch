From 4d430cb95cfb4993741bbfbba9c67baf0db4ca4e Mon Sep 17 00:00:00 2001
From: Juan <juan@example.com>
Date: Mon, 14 Sep 2026 23:57:35 +0000
Subject: [PATCH] Corrige liberacoes: backfill do vendedor em vendas antigas do
 ML

Vendas confirmadas antes da coluna ml_seller_id existir ficavam sem saber
de qual conta usar o access_token, entao 'Atualizar liberacoes' ignorava
todas elas. Esse backfill recupera o vendedor de cada pedido a partir do
raw_order_payload ja salvo (campo seller.id, dado real do pedido, nao uma
suposicao). Tambem adiciona um parametro de diagnostico no endpoint de
debug pra inspecionar a resposta real da API de liberacao de pagamento.
---
 drizzle/0010_backfill_ml_seller_id.sql  |  26 +
 drizzle/meta/0010_snapshot.json         | 844 ++++++++++++++++++++++++
 drizzle/meta/_journal.json              |   7 +
 src/app/api/mercadolivre/debug/route.ts |  18 +-
 4 files changed, 890 insertions(+), 5 deletions(-)
 create mode 100644 drizzle/0010_backfill_ml_seller_id.sql
 create mode 100644 drizzle/meta/0010_snapshot.json

diff --git a/drizzle/0010_backfill_ml_seller_id.sql b/drizzle/0010_backfill_ml_seller_id.sql
new file mode 100644
index 0000000..1a6c7d1
--- /dev/null
+++ b/drizzle/0010_backfill_ml_seller_id.sql
@@ -0,0 +1,26 @@
+-- Preenche ml_seller_id em vendas/pendentes do Mercado Livre confirmadas
+-- ANTES dessa coluna existir (migração 0009) — sem isso, "Atualizar
+-- liberações" não consegue saber de qual conta usar o access_token e ignora
+-- essas vendas silenciosamente.
+--
+-- O vendedor de cada pedido já estava salvo o tempo todo dentro de
+-- raw_order_payload (o JSON bruto que o Mercado Livre devolve em
+-- GET /orders/$id tem um campo "seller": {"id": ...}) — não é uma
+-- suposição, é o dado real do pedido, então esse backfill é exato, não uma
+-- aproximação.
+
+-- 1) pending_sales: extrai o vendedor direto do payload bruto do pedido.
+UPDATE "pending_sales"
+SET "ml_seller_id" = raw_order_payload -> 'seller' ->> 'id'
+WHERE "ml_seller_id" IS NULL
+  AND raw_order_payload -> 'seller' ->> 'id' IS NOT NULL;
+--> statement-breakpoint
+
+-- 2) sales: propaga o vendedor a partir da linha de pending_sales que deu
+-- origem a essa venda (resulting_sale_id aponta de pending_sales -> sales).
+UPDATE "sales"
+SET "ml_seller_id" = "pending_sales"."ml_seller_id"
+FROM "pending_sales"
+WHERE "sales"."id" = "pending_sales"."resulting_sale_id"
+  AND "sales"."ml_seller_id" IS NULL
+  AND "pending_sales"."ml_seller_id" IS NOT NULL;
